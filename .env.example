# Kopieer naar .env.local voor lokale ontwikkeling:
#   cp .env.example .env.local
#
# Productie-app: https://vvh.clvs.nl
# Nevobo-verenigingscode (standaard VVH Harlingen)
NEVOBO_VERENIGING_ID=CKL6L32

# Optioneel: extra LAN-IP's voor npm run dev (next.config → allowedDevOrigins)
# ALLOWED_DEV_ORIGINS=192.168.1.50

# Pushmeldingen (uit als deze ontbreken). Sleutels maken met:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://vvh.clvs.nl
# Map voor abonnementen + laatste stand (standaard ./data)
# PUSH_DATA_DIR=./data
